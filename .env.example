# SQL Server Srv-MPerfect – hesla jsou uložená jen na serveru (.env na VPS), do prohlížeče nikdy nejdou
# CLB1: trvalé příkazy (tabulka Salda_TrvalePrikazy)
SQL_SERVER=90.182.39.103
SQL_PORT=1433
SQL_DATABASE=CLB1
SQL_USER=clb1_app
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_CERT=true
SQL_TIMEOUT_MS=20000

# Helios (saldokonto, jen čtení) – stejné hodnoty jako v /opt/jhn-apps/.env; server a port se berou ze SQL_SERVER / SQL_PORT
DB_HELIOS005_DATABASE=Helios005
DB_HELIOS005_USER=
DB_HELIOS005_PASSWORD=
DB_HELIOS004_DATABASE=Helios004
DB_HELIOS004_USER=
DB_HELIOS004_PASSWORD=

# Jen pro samostatný server (server.mjs na VPS): port a adresa, na které poslouchá za reverse proxy (Caddy)
PORT=3091
HOST=127.0.0.1
